{
  "meta": {
    "source_system": "oracle",
    "target_system": "odoo",
    "version": "1.0",
    "description": "Curated migration-relevant entities and fields for Oracle Fusion to Odoo migrations. Oracle field names are based on standard Oracle CX/FSCM/HCM REST API field names (v1). Tenant-specific flex fields (DFF/EFF) are excluded — add them as custom fields in practice.",
    "assumptions": [
      "Oracle CRM field names follow PascalCase as returned by the REST API (e.g. PartyName, AccountName).",
      "Oracle FSCM Invoices use the /receivablesInvoices and /payablesInvoices REST resource field names.",
      "Oracle HCM Workers use the /workers REST resource field names.",
      "Odoo target field names are standard Odoo 16/17 community field names.",
      "Supplier and Customer both map to res.partner with different rank values — filtering is handled at connector level.",
      "Oracle Accounts (CRM) = companies → res.partner with is_company=True.",
      "Oracle Contacts (CRM) = persons → res.partner with is_company=False."
    ]
  },
