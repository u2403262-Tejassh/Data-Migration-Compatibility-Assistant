  "meta": {
    "source_system": "odoo",
    "target_system": "oracle",
    "version": "1.0",
    "description": "Curated migration-relevant entities and fields for Odoo to Oracle Fusion migrations. Oracle target field names follow the standard Oracle REST API PascalCase conventions. Odoo source fields are standard Odoo 16/17 community field names.",
    "assumptions": [
      "Oracle CRM target fields follow PascalCase as consumed by the REST API (e.g. PartyName, AccountName).",
      "Oracle FSCM Invoices use the /receivablesInvoices and /payablesInvoices REST resource field names.",
      "Oracle HCM Workers use the /workers REST resource field names.",
      "Odoo res.partner covers both contacts (is_company=False) and companies (is_company=True).",
      "Supplier and Customer both map to Oracle res.partner equivalents with different classifications.",
      "account.move in Odoo maps to Oracle FSCM Invoices; move_type distinguishes AR vs AP.",
      "hr.employee maps to Oracle HCM Worker resource."
    ]
  },
